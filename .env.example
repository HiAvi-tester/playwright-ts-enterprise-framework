# Reference list of overridable settings (defaults live in utils/env.ts).
# Export them in your shell or set them as GitHub Actions secrets/variables, e.g.
#   WEB_BASE_URL=https://staging.example.com npx playwright test
WEB_BASE_URL=https://www.saucedemo.com
SAUCE_USERNAME=standard_user
SAUCE_PASSWORD=secret_sauce
API_BASE_URL=https://restful-booker.herokuapp.com
BOOKER_USERNAME=admin
BOOKER_PASSWORD=password123
# OrangeHRM public demo (credentials are published on its login page)
HRM_BASE_URL=https://opensource-demo.orangehrmlive.com
HRM_USERNAME=Admin
HRM_PASSWORD=admin123
# Automation Exercise (UI + REST API, no login needed for the API)
AE_BASE_URL=https://automationexercise.com
# Optional tuning
# WORKERS=4
# RETRIES=1
