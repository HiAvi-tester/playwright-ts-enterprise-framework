{
  "name": "playwright-ts-enterprise-framework",
  "version": "1.0.0",
  "description": "Production-grade Playwright + TypeScript framework: Page Object Model, custom fixtures, reusable auth state, API testing with JSON schema validation, sharded CI.",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:e2e": "playwright test --project=chromium --project=firefox",
    "test:api": "playwright test --project=api",
    "test:headed": "playwright test --project=chromium --headed",
    "test:debug": "playwright test --project=chromium --debug",
    "report": "playwright show-report",
    "allure:report": "allure generate allure-results --clean -o allure-report && allure open allure-report",
    "typecheck": "tsc --noEmit",
    "list": "playwright test --list"
  },
  "keywords": ["playwright", "typescript", "test-automation", "e2e", "api-testing", "sdet"],
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.11",
    "ajv": "^8.20.0",
    "allure-commandline": "^2.32.0",
    "allure-playwright": "^3.15.0",
    "typescript": "^7.0.2"
  }
}
